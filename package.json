{
  "name": "edgelisted-lite",
  "version": "0.1.2",
  "description": "EdgeListed Lite: a minimal remote MCP server (Streamable HTTP) plus OpenAPI 3.1 JSON API from one tool definition, on Cloudflare Workers.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "check:deploy": "wrangler deploy --dry-run --outdir dist"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.152.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
